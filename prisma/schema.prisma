generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  TEAM_MANAGER
}

enum SexCategory {
  MALE
  FEMALE
}

enum PairMatchCategory {
  MENS
  WOMENS
  MIXED
}

enum MatchupStage {
  GROUP
  ROUND_ROBIN
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
  THIRD_PLACE
  CUSTOM
}

enum DivisionFormat {
  GROUP_KNOCKOUT
  ROUND_ROBIN
  SINGLE_ELIMINATION
  CUSTOM
}

enum DivisionEntrantType {
  TEAM
  PLAYER
  PAIR
}

enum PlayerParticipationStatus {
  POOL
  CONFIRMED
  UNAVAILABLE
  WITHDRAWN
}

enum EmploymentType {
  PERMANENT
  JOB_ORDER
}

enum DivisionPlayerStatus {
  ELIGIBLE
  CONFIRMED
  UNAVAILABLE
  WITHDRAWN
}

enum MatchupStatus {
  SCHEDULED
  LINEUP_PENDING
  READY
  LIVE
  COMPLETED
  FORFEITED
  INTERRUPTED
}

enum GameStatus {
  SCHEDULED
  LIVE
  COMPLETED
  FORFEITED
  INTERRUPTED
}

enum VotingCodeStatus {
  UNUSED
  ISSUED
  USED
  REVOKED
  REPLACED
}

enum SimulationStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  UNDONE
  FAILED
}

enum CheckpointKind {
  MANUAL
  AUTOMATIC
}

model Tournament {
  id                      String    @id @default(cuid())
  name                    String
  slug                    String    @unique
  season                  String
  isPublished             Boolean   @default(true)
  votingOpen              Boolean   @default(false)
  votingDeadline          DateTime?
  simulationMode          Boolean   @default(false)
  destructiveToolsEnabled Boolean   @default(false)
  activeCourtCount        Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  divisions      Division[]
  groups         Group[]
  players        Player[]
  matchups       Matchup[]
  votingCodes    VotingCode[]
  votingCodeBatches VotingCodeBatch[]
  fanVotes       FanVote[]
  voteAttempts   VoteAttempt[]
  simulationRuns SimulationRun[]
  checkpoints    Checkpoint[]
  auditLogs      AuditLog[]
  mvpSelections  MvpSelection[]
  pageViews      PageView[]

  @@index([isPublished])
}

model Division {
  id                     String              @id @default(cuid())
  tournamentId           String
  tournament             Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  formatType             DivisionFormat      @default(CUSTOM)
  entrantType            DivisionEntrantType @default(TEAM)
  sexCategory            SexCategory?
  defaultGamesPerMatchup  Int                 @default(1)
  knockoutGamesPerMatchup Int?
  groupMatchCategories          PairMatchCategory[] @default([])
  knockoutMatchCategories       PairMatchCategory[] @default([])
  groupCategoryRulesEnabled     Boolean             @default(false)
  knockoutCategoryRulesEnabled  Boolean             @default(false)
  qualifiersPerGroup      Int                 @default(1)
  wildcardCount           Int                 @default(0)
  autoProgression         Boolean             @default(false)
  wildcardMode            String              @default("STANDARD")
  wildcardBattleSize      Int                 @default(8)
  thirdPlaceEnabled       Boolean             @default(false)
  suddenDeathAtTen        Boolean             @default(false)
  advancementRule        String?
  guideNotes             String?
  isPublic               Boolean             @default(true)
  championImageUrl       String?
  championImageTeamId    String?
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  groups        Group[]
  teams         Team[]
  matchups      Matchup[]
  playerEntries DivisionPlayer[]
  mvpSelections MvpSelection[]

  @@unique([tournamentId, slug])
  @@index([tournamentId, sortOrder])
}

model Group {
  id                String                  @id @default(cuid())
  name              String
  slug              String
  tournamentId      String
  tournament        Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId        String
  division          Division                @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  teams             Team[]
  standingOverrides GroupStandingOverride[]

  @@unique([tournamentId, slug])
  @@index([divisionId])
}

model Team {
  id                String                  @id @default(cuid())
  name              String
  shortName         String
  logoUrl           String?
  brandingPrimary   String?
  brandingSecondary String?
  brandingAccent    String?
  brandingText      String?
  brandingSurface   String?
  divisionId        String
  division          Division                @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  groupId           String?
  group             Group?                  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupPosition     Int?
  players           Player[]
  pairs             Pair[]
  users             User[]
  homeMatchups      Matchup[]               @relation("HomeTeam")
  awayMatchups      Matchup[]               @relation("AwayTeam")
  winnerMatchups    Matchup[]               @relation("MatchupWinner")
  lineups           Lineup[]
  homeGames         Game[]                  @relation("HomePairTeam")
  awayGames         Game[]                  @relation("AwayPairTeam")
  standingOverrides GroupStandingOverride[]

  @@unique([groupId, groupPosition])
  @@index([divisionId, name])
  @@index([divisionId, groupId, shortName])
}

model GroupStandingOverride {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, teamId])
  @@unique([groupId, position])
  @@index([teamId])
}

model Player {
  id                  String                    @id @default(cuid())
  firstName           String
  middleInitial       String?
  lastName            String
  displayName         String?
  avatarUrl           String?
  sex                 SexCategory
  employmentType      EmploymentType?
  office              String?
  isActive            Boolean                   @default(true)
  participationStatus PlayerParticipationStatus @default(POOL)
  tournamentId        String
  tournament          Tournament                @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId              String?
  team                Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  divisionEntries     DivisionPlayer[]
  pairAsA             Pair[]                    @relation("PairPlayerA")
  pairAsB             Pair[]                    @relation("PairPlayerB")
  user                User?
  fanVotes            FanVote[]
  mvpSelections       MvpSelection[]

  @@index([tournamentId, participationStatus, isActive])
  @@index([teamId, sex, isActive])
}

model DivisionPlayer {
  id         String               @id @default(cuid())
  divisionId String
  division   Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     DivisionPlayerStatus @default(ELIGIBLE)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([divisionId, playerId])
  @@index([playerId, status])
}

model Pair {
  id          String       @id @default(cuid())
  label       String
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerAId   String
  playerA     Player       @relation("PairPlayerA", fields: [playerAId], references: [id], onDelete: Restrict)
  playerBId   String
  playerB     Player       @relation("PairPlayerB", fields: [playerBId], references: [id], onDelete: Restrict)
  isActive    Boolean      @default(true)
  homeGames   Game[]       @relation("HomePair")
  awayGames   Game[]       @relation("AwayPair")
  lineupSlots LineupSlot[]

  @@unique([teamId, label])
  @@index([teamId, isActive])
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           UserRole
  teamId         String?
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId       String?         @unique
  player         Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  auditLogs      AuditLog[]
  simulationRuns SimulationRun[]
  checkpoints    Checkpoint[]
  scoreEvents    ScoreEvent[]
  mvpSelections  MvpSelection[] @relation("MvpSelectionActor")
}

model MvpSelection {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  sexCategory  SexCategory
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  selectedById String?
  selectedBy   User?       @relation("MvpSelectionActor", fields: [selectedById], references: [id], onDelete: SetNull)
  selectedAt   DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([divisionId, sexCategory])
  @@index([tournamentId, divisionId])
}

model Matchup {
  id              String        @id @default(cuid())
  tournamentId    String
  tournament      Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId      String
  division        Division      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  stage           MatchupStage
  groupLabel      String?
  roundLabel      String
  roundNumber     Int?
  order           Int
  gamesPerMatchup Int           @default(1)
  homeTeamId      String?
  homeTeam        Team?         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId      String?
  awayTeam        Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  homeQualificationSource String?
  awayQualificationSource String?
  bracketTrack     String        @default("CHAMPIONSHIP")
  status          MatchupStatus @default(LINEUP_PENDING)
  scheduledAt     DateTime?
  courtLabel      String?
  queuePosition   Int?
  winnerTeamId    String?
  winnerTeam      Team?         @relation("MatchupWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  homeWins        Int           @default(0)
  awayWins        Int           @default(0)
  version         Int           @default(0)
  games           Game[]
  lineups         Lineup[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([divisionId, bracketTrack, stage, order])
  @@index([tournamentId, divisionId, bracketTrack, stage, groupLabel, order])
  @@index([tournamentId, status, scheduledAt])
  @@index([tournamentId, queuePosition])
}

model Lineup {
  id          String       @id @default(cuid())
  matchupId   String
  matchup     Matchup      @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedAt DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slots       LineupSlot[]

  @@unique([matchupId, teamId])
}

model LineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  slot     Int
  pairId   String
  pair     Pair   @relation(fields: [pairId], references: [id], onDelete: Restrict)

  @@unique([lineupId, slot])
  @@unique([lineupId, pairId])
}

model Game {
  id           String       @id @default(cuid())
  matchupId    String
  matchup      Matchup      @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  gameNumber   Int
  homeTeamId   String
  homeTeam     Team         @relation("HomePairTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId   String
  awayTeam     Team         @relation("AwayPairTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homePairId   String
  homePair     Pair         @relation("HomePair", fields: [homePairId], references: [id], onDelete: Restrict)
  awayPairId   String
  awayPair     Pair         @relation("AwayPair", fields: [awayPairId], references: [id], onDelete: Restrict)
  homeScore    Int          @default(0)
  awayScore    Int          @default(0)
  status       GameStatus   @default(SCHEDULED)
  winnerTeamId String?
  version      Int          @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  scoreEvents  ScoreEvent[]

  @@unique([matchupId, gameNumber])
  @@index([status, startedAt])
}

model ScoreEvent {
  id              String         @id @default(cuid())
  gameId          String
  game            Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  simulationRunId String?
  simulationRun   SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  action          String
  beforeState     Json
  afterState      Json
  reason          String?
  undoneAt        DateTime?
  createdAt       DateTime       @default(now())

  @@index([gameId, createdAt])
  @@index([simulationRunId])
}

model VotingCodeBatch {
  id           String       @id @default(cuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  quantity     Int
  releaseAt    DateTime
  cancelledAt  DateTime?
  codes        VotingCode[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tournamentId, releaseAt])
  @@index([tournamentId, cancelledAt])
}

model VotingCode {
  id                String           @id @default(cuid())
  tournamentId      String
  tournament        Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             VotingCodeBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  publicCode        String?
  codeHash          String           @unique
  codeHint          String
  status            VotingCodeStatus @default(UNUSED)
  issuedAt          DateTime?
  usedAt            DateTime?
  revokedAt         DateTime?
  replacementReason String?
  replacedById      String?          @unique
  replacedBy        VotingCode?      @relation("CodeReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          VotingCode?      @relation("CodeReplacement")
  votes             FanVote[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tournamentId, status])
  @@index([batchId, status])
}

model FanVote {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  votingCodeId String
  votingCode   VotingCode  @relation(fields: [votingCodeId], references: [id], onDelete: Restrict)
  sexCategory  SexCategory
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@unique([votingCodeId, sexCategory])
  @@index([tournamentId, playerId])
  @@index([tournamentId, sexCategory, playerId])
}

model VoteAttempt {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ipHash       String
  visitorKey   String?
  codeHint     String?
  success      Boolean    @default(false)
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, ipHash, success, createdAt])
  @@index([tournamentId, visitorKey, success, createdAt])
}

model PageView {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  visitorKey   String
  path         String
  referrerHost String?
  deviceType   String
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
  @@index([tournamentId, path, createdAt])
  @@index([tournamentId, visitorKey, createdAt])
}

model SimulationRun {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind         String
  seed         String?
  status       SimulationStatus @default(RUNNING)
  options      Json?
  result       Json?
  error        String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  auditLogs    AuditLog[]
  scoreEvents  ScoreEvent[]

  @@index([tournamentId, createdAt])
  @@index([status])
}

model Checkpoint {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  kind         CheckpointKind @default(MANUAL)
  snapshot     Json
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([tournamentId, createdAt])
}

model AuditLog {
  id              String         @id @default(cuid())
  tournamentId    String?
  tournament      Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action          String
  entityType      String
  entityId        String?
  beforeState     Json?
  afterState      Json?
  reason          String?
  simulation      Boolean        @default(false)
  simulationRunId String?
  simulationRun   SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([tournamentId, createdAt])
  @@index([action, entityType])
  @@index([simulationRunId])
}
