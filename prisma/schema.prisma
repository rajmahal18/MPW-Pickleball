generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM_LEADER
}

enum SexCategory {
  MALE
  FEMALE
}

enum MatchupStage {
  GROUP
  SEMIFINAL
  FINAL
}

enum MatchupStatus {
  SCHEDULED
  LINEUP_PENDING
  READY
  LIVE
  COMPLETED
  FORFEITED
  INTERRUPTED
}

enum GameStatus {
  SCHEDULED
  LIVE
  COMPLETED
  FORFEITED
  INTERRUPTED
}

enum VotingCodeStatus {
  UNUSED
  ISSUED
  USED
  REVOKED
  REPLACED
}

enum SimulationStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  UNDONE
  FAILED
}

enum CheckpointKind {
  MANUAL
  AUTOMATIC
}

model Tournament {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  season                   String
  isPublished              Boolean  @default(true)
  votingOpen               Boolean  @default(false)
  votingDeadline           DateTime?
  simulationMode           Boolean  @default(false)
  destructiveToolsEnabled  Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  groups         Group[]
  matchups       Matchup[]
  votingCodes    VotingCode[]
  fanVotes       FanVote[]
  voteAttempts   VoteAttempt[]
  simulationRuns SimulationRun[]
  checkpoints    Checkpoint[]
  auditLogs      AuditLog[]

  @@index([isPublished])
}

model Group {
  id           String     @id @default(cuid())
  name         String
  slug         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@unique([tournamentId, slug])
}

model Team {
  id             String    @id @default(cuid())
  name           String
  shortName      String
  logoUrl        String?
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  players        Player[]
  pairs          Pair[]
  users          User[]
  homeMatchups   Matchup[] @relation("HomeTeam")
  awayMatchups   Matchup[] @relation("AwayTeam")
  winnerMatchups Matchup[] @relation("MatchupWinner")
  lineups        Lineup[]
  homeGames      Game[]    @relation("HomePairTeam")
  awayGames      Game[]    @relation("AwayPairTeam")

  @@unique([groupId, name])
  @@index([groupId, shortName])
}

model Player {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  sex         SexCategory
  isActive    Boolean     @default(true)
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pairAsA     Pair[]      @relation("PairPlayerA")
  pairAsB     Pair[]      @relation("PairPlayerB")
  user        User?
  fanVotes    FanVote[]

  @@unique([teamId, firstName, lastName])
  @@index([teamId, sex, isActive])
}

model Pair {
  id          String   @id @default(cuid())
  label       String
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerAId   String
  playerA     Player   @relation("PairPlayerA", fields: [playerAId], references: [id], onDelete: Restrict)
  playerBId   String
  playerB     Player   @relation("PairPlayerB", fields: [playerBId], references: [id], onDelete: Restrict)
  isActive    Boolean  @default(true)
  homeGames   Game[]   @relation("HomePair")
  awayGames   Game[]   @relation("AwayPair")
  lineupSlots LineupSlot[]

  @@unique([teamId, label])
  @@index([teamId, isActive])
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           UserRole
  teamId         String?
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId       String?         @unique
  player         Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  auditLogs      AuditLog[]
  simulationRuns SimulationRun[]
  checkpoints    Checkpoint[]
  scoreEvents    ScoreEvent[]
}

model Matchup {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage        MatchupStage
  groupLabel   String?
  roundLabel   String
  roundNumber  Int?
  order        Int
  homeTeamId   String?
  homeTeam     Team?         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId   String?
  awayTeam     Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  status       MatchupStatus @default(LINEUP_PENDING)
  scheduledAt  DateTime?
  courtLabel   String?
  winnerTeamId String?
  winnerTeam   Team?         @relation("MatchupWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  homeWins     Int           @default(0)
  awayWins     Int           @default(0)
  version      Int           @default(0)
  games        Game[]
  lineups      Lineup[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tournamentId, stage, order])
  @@index([tournamentId, stage, groupLabel, order])
  @@index([tournamentId, status, scheduledAt])
}

model Lineup {
  id          String       @id @default(cuid())
  matchupId   String
  matchup     Matchup      @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedAt DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slots       LineupSlot[]

  @@unique([matchupId, teamId])
}

model LineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  slot     Int
  pairId   String
  pair     Pair   @relation(fields: [pairId], references: [id], onDelete: Restrict)

  @@unique([lineupId, slot])
  @@unique([lineupId, pairId])
}

model Game {
  id           String     @id @default(cuid())
  matchupId    String
  matchup      Matchup    @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  gameNumber   Int
  homeTeamId   String
  homeTeam     Team       @relation("HomePairTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId   String
  awayTeam     Team       @relation("AwayPairTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homePairId   String
  homePair     Pair       @relation("HomePair", fields: [homePairId], references: [id], onDelete: Restrict)
  awayPairId   String
  awayPair     Pair       @relation("AwayPair", fields: [awayPairId], references: [id], onDelete: Restrict)
  homeScore    Int        @default(0)
  awayScore    Int        @default(0)
  status       GameStatus @default(SCHEDULED)
  winnerTeamId String?
  version      Int        @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  scoreEvents  ScoreEvent[]

  @@unique([matchupId, gameNumber])
  @@index([status, startedAt])
}

model ScoreEvent {
  id              String         @id @default(cuid())
  gameId          String
  game            Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  simulationRunId String?
  simulationRun   SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  action          String
  beforeState     Json
  afterState      Json
  reason          String?
  undoneAt        DateTime?
  createdAt       DateTime       @default(now())

  @@index([gameId, createdAt])
  @@index([simulationRunId])
}

model VotingCode {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  codeHash     String           @unique
  codeHint     String
  status       VotingCodeStatus @default(UNUSED)
  issuedAt     DateTime?
  usedAt       DateTime?
  revokedAt    DateTime?
  replacementReason String?
  replacedById String?          @unique
  replacedBy   VotingCode?      @relation("CodeReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     VotingCode?      @relation("CodeReplacement")
  vote         FanVote?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tournamentId, status])
}

model FanVote {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  votingCodeId String      @unique
  votingCode   VotingCode  @relation(fields: [votingCodeId], references: [id], onDelete: Restrict)
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@index([tournamentId, playerId])
}

model VoteAttempt {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ipHash       String
  codeHint     String?
  success      Boolean    @default(false)
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, ipHash, success, createdAt])
}

model SimulationRun {
  id          String           @id @default(cuid())
  tournamentId String
  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind        String
  seed        String?
  status      SimulationStatus @default(RUNNING)
  options     Json?
  result      Json?
  error       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  auditLogs   AuditLog[]
  scoreEvents ScoreEvent[]

  @@index([tournamentId, createdAt])
  @@index([status])
}

model Checkpoint {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  kind         CheckpointKind @default(MANUAL)
  snapshot     Json
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([tournamentId, createdAt])
}

model AuditLog {
  id              String         @id @default(cuid())
  tournamentId    String?
  tournament      Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action          String
  entityType      String
  entityId        String?
  beforeState     Json?
  afterState      Json?
  reason          String?
  simulation      Boolean        @default(false)
  simulationRunId String?
  simulationRun   SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([tournamentId, createdAt])
  @@index([action, entityType])
  @@index([simulationRunId])
}
