generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM_LEADER
}

enum MatchupStage {
  GROUP
  SEMIFINAL
  FINAL
}

enum MatchupStatus {
  SCHEDULED
  LINEUP_PENDING
  READY
  LIVE
  COMPLETED
}

enum GameStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  season      String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[]
  matchups    Matchup[]
}

model Group {
  id           String     @id @default(cuid())
  name         String
  slug         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@unique([tournamentId, slug])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  shortName   String
  logoUrl     String?
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  players     Player[]
  pairs       Pair[]
  users       User[]
  homeMatchups Matchup[] @relation("HomeTeam")
  awayMatchups Matchup[] @relation("AwayTeam")
  winnerMatchups Matchup[] @relation("MatchupWinner")
  lineups     Lineup[]
  homeGames   Game[] @relation("HomePairTeam")
  awayGames   Game[] @relation("AwayPairTeam")

  @@unique([groupId, name])
}

model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pairAsA   Pair[]   @relation("PairPlayerA")
  pairAsB   Pair[]   @relation("PairPlayerB")
  user      User?

  @@unique([teamId, firstName, lastName])
}

model Pair {
  id        String   @id @default(cuid())
  label     String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerAId String
  playerA   Player   @relation("PairPlayerA", fields: [playerAId], references: [id], onDelete: Restrict)
  playerBId String
  playerB   Player   @relation("PairPlayerB", fields: [playerBId], references: [id], onDelete: Restrict)
  homeGames Game[]   @relation("HomePair")
  awayGames Game[]   @relation("AwayPair")
  lineupSlots LineupSlot[]

  @@unique([teamId, label])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId     String?  @unique
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model Matchup {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage        MatchupStage
  groupLabel   String?
  roundLabel   String
  order        Int
  homeTeamId   String?
  homeTeam     Team?         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId   String?
  awayTeam     Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  status       MatchupStatus @default(LINEUP_PENDING)
  scheduledAt  DateTime?
  courtLabel   String?
  winnerTeamId String?
  winnerTeam   Team?         @relation("MatchupWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  homeWins     Int           @default(0)
  awayWins     Int           @default(0)
  games        Game[]
  lineups      Lineup[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tournamentId, stage, groupLabel, order])
}

model Lineup {
  id        String       @id @default(cuid())
  matchupId String
  matchup   Matchup      @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedAt DateTime    @default(now())
  slots     LineupSlot[]

  @@unique([matchupId, teamId])
}

model LineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  slot     Int
  pairId   String
  pair     Pair   @relation(fields: [pairId], references: [id], onDelete: Restrict)

  @@unique([lineupId, slot])
  @@unique([lineupId, pairId])
}

model Game {
  id          String     @id @default(cuid())
  matchupId   String
  matchup     Matchup    @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  gameNumber  Int
  homeTeamId  String
  homeTeam    Team       @relation("HomePairTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId  String
  awayTeam    Team       @relation("AwayPairTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homePairId  String
  homePair    Pair       @relation("HomePair", fields: [homePairId], references: [id], onDelete: Restrict)
  awayPairId  String
  awayPair    Pair       @relation("AwayPair", fields: [awayPairId], references: [id], onDelete: Restrict)
  homeScore   Int        @default(0)
  awayScore   Int        @default(0)
  status      GameStatus @default(SCHEDULED)
  winnerTeamId String?
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([matchupId, gameNumber])
}
